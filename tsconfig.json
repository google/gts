{
  "extends": "./tsconfig-google.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "src/**/*.ts", "test/**/*.ts"],
  "exclude": ["build", "node_modules", "test/fixtures/**/*.*", "template/**/*.*"]
}